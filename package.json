{
	"name": "batched-function",
	"version": "2.0.1",
	"description": "Batch multiple function calls into a single one",
	"license": "MIT",
	"repository": "Richienb/batched-function",
	"type": "module",
	"exports": "./dist/index.js",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "del-cli dist && tsc",
		"test": "xo && ava && tsc && tsd",
		"prepublishOnly": "del-cli dist && tsc"
	},
	"files": [
		"dist"
	],
	"types": "dist/index.d.ts",
	"keywords": [
		"function",
		"batch",
		"interval"
	],
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.0.1",
		"ava": "^6.4.1",
		"del-cli": "^6.0.0",
		"time-span": "^5.1.0",
		"ts-node": "^10.9.2",
		"tsd": "^0.33.0",
		"typescript": "^5.9.2",
		"xo": "^1.2.2"
	},
	"ava": {
		"extensions": {
			"ts": "module"
		},
		"nodeArguments": [
			"--import=ts-node/esm"
		]
	}
}
